 <% if( errors.length > 0 ) {%>

          <div class="bg-red-100 border-red-400 text-red-300 px-4 py-3 rounded relative " role="alert">
            <strong class="font-bold">Error!</strong>
            <span>
              <% errors.forEach(error =>{ %>
                <li>
                  <%= error %>
                </li>
                <%})%>
            </span>
          </div>
        <% }%>