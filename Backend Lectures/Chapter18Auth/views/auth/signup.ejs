<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto mt-8 p-8 bg-white rounded-lg shadow-md">
      <h1 class="text-3xl font-bold mb-6 text-center text-gray-800">Register as a new user</h1>
      <form action="/signup" method="POST" class="max-w-md mx-auto">
              <!-- Errors Partial -->
       <%- include('../partials/errors') %>
          <input
          type="text"
          required
          name="firstName"
          placeholder="First Name"
            value="<%= oldInput.firstName ? oldInput.firstName : '' %>" 
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
       
        <input
          type="text"
          required
          name="lastName"
          placeholder="Last Name"
            value="<%= oldInput.lastName ? oldInput.lastName : '' %>" 
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
         <input
          type="email"
          required
          name="email"
          value="<%= oldInput.email ? oldInput.email : ''%> "
          placeholder="test@gmail.com"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
          <input
          type="password"
          required
          name="password"
          placeholder=" Enter your Password"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
             <input
          type="password"
          required
          name="confirmPassword"
          placeholder="Confirm Password"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
         
        <div class="mb-4">
          <p class="font-semibold mb-2 text-gray-700">User Type:</p>

          <label class="inline-flex items-center mr-6">
            <input
              type="radio"
              name="userType"
              value="host"
              id="host"
              class="form-radio h-4 w-4 text-red-600"
              <%= oldInput.userType === "host" ? "checked" : "" %>
            />
            <span class="ml-2 text-gray-700">Host</span>
          </label>

          <label class="inline-flex items-center">
            <input
              type="radio"
              name="userType"
              value="guest"
              id="guest"
              class="form-radio h-4 w-4 text-red-600"
              <%= oldInput.userType === "guest" ? "checked" : "" %>
            />
            <span class="ml-2 text-gray-700">Guest</span>
          </label>
        </div>

        <div class="mb-6 inline-flex items-center">
          <input type="checkbox" name="terms" id="terms" class="form-checkbox h-4 w-4 text-red-600 rounded" required  >
          <label for="terms" class="ml-2 text-sm text-gray-700"> I agree with terms and conditions</label>
        </div>
        <input type="submit" value="Resgister" class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300" />
      
      </form>
    </main>
  </body>
</html>
